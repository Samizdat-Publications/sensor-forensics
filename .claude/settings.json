{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Edit",
      "WebSearch",
      "WebFetch",
      "Bash(git *)",
      "PowerShell(git *)",
      "Bash(gh *)",
      "PowerShell(gh *)",
      "Bash(python *)",
      "PowerShell(python *)",
      "Bash(py *)",
      "PowerShell(py *)",
      "Bash(pip *)",
      "PowerShell(pip *)",
      "Bash(uv *)",
      "PowerShell(uv *)",
      "Bash(node *)",
      "PowerShell(node *)",
      "Bash(npm *)",
      "PowerShell(npm *)",
      "Bash(npx *)",
      "PowerShell(npx *)",
      "Bash(pnpm *)",
      "PowerShell(pnpm *)",
      "Bash(ffmpeg *)",
      "PowerShell(ffmpeg *)",
      "Bash(ffprobe *)",
      "PowerShell(ffprobe *)",
      "Bash(curl *)",
      "PowerShell(curl *)",
      "Bash(winget *)",
      "PowerShell(winget *)",
      "Bash(where *)",
      "PowerShell(where *)",
      "Bash(which *)",
      "PowerShell(which *)",
      "Bash(ls *)",
      "PowerShell(ls *)",
      "Bash(dir *)",
      "PowerShell(dir *)",
      "Bash(mkdir *)",
      "PowerShell(mkdir *)",
      "Bash(cp *)",
      "PowerShell(cp *)",
      "Bash(mv *)",
      "PowerShell(mv *)",
      "Bash(cat *)",
      "PowerShell(cat *)",
      "Bash(head *)",
      "PowerShell(head *)",
      "Bash(tail *)",
      "PowerShell(tail *)",
      "Bash(find *)",
      "PowerShell(find *)",
      "Bash(grep *)",
      "PowerShell(grep *)",
      "Bash(Get-ChildItem *)",
      "PowerShell(Get-ChildItem *)",
      "Bash(Get-Content *)",
      "PowerShell(Get-Content *)",
      "Bash(New-Item *)",
      "PowerShell(New-Item *)",
      "Bash(Copy-Item *)",
      "PowerShell(Copy-Item *)",
      "Bash(Move-Item *)",
      "PowerShell(Move-Item *)",
      "Bash(Test-Path *)",
      "PowerShell(Test-Path *)",
      "Bash(Invoke-WebRequest *)",
      "PowerShell(Invoke-WebRequest *)",
      "Bash(Expand-Archive *)",
      "PowerShell(Expand-Archive *)",
      "Bash(./tools/*)",
      "PowerShell(./tools/*)",
      "PowerShell(.\\tools\\*)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo create * --public *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push --force-with-lease *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(gh repo delete *)",
      "PowerShell(gh repo edit *)",
      "PowerShell(gh repo create * --public *)",
      "Read(./.env)",
      "Bash(git add -A*)",
      "Bash(git add .)",
      "Bash(git add . *)",
      "PowerShell(git add -A*)",
      "PowerShell(git add .)",
      "PowerShell(git add . *)"
    ]
  }
}